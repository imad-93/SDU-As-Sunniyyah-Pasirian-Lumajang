/* =========================================================
   7. DASHBOARD KANTIN — KASIR SCAN QR
   Alur: (1) scan QR barang sampai semua item masuk
         (2) scan QR siswa → validasi saldo & limit otomatis
         (3) proses (saldo / cash) atau tolak & batalkan item
   ========================================================= */
const kasir = { step: 'items', cart: [], siswaId: null, metode: 'Saldo', diterima: 0, hasil: null };
function kasirReset() { Object.assign(kasir, { step: 'items', cart: [], siswaId: null, metode: 'Saldo', diterima: 0, hasil: null }); }
const kasirTotal = () => kasir.cart.reduce((a, c) => a + c.harga * c.qty, 0);
const evalKasir = () => validasiBelanja(kasir.siswaId, kasirTotal(), kasir.metode);

function viewKasir() {
  return `
  <div id="kasirRoot">
    <div id="kasirSteps"></div>
    <div class="two-col">
      <div class="card">
        <div class="card-head"><div><h3 id="kasirScanTitle"></h3><p id="kasirScanSub"></p></div></div>
        <div class="cam-box" id="kasirCam">
          <video id="kasirVideo" playsinline muted></video>
          <div class="cam-ph">📷 Kamera nonaktif<br>Klik “Aktifkan Kamera”, gunakan scanner barcode, atau ketik kode di bawah</div>
        </div>
        <button class="btn btn-ghost w100" id="btnCam" style="margin-top:10px">📷 Aktifkan Kamera</button>
        <form class="manual-form" id="formManual" style="margin-top:10px">
          <input id="inManual" autocomplete="off" autofocus>
          <button class="btn btn-primary" type="submit">OK</button>
        </form>
        <div id="kasirQuick" style="margin-top:16px"></div>
      </div>
      <div class="card" id="kasirPanel"></div>
    </div>
  </div>`;
}

function bindKasir() {
  const root = $('#kasirRoot');
  renderKasirStep(); renderKasirPanel();

  $('#btnCam').addEventListener('click', e =>
    camToggle(e.currentTarget, $('#kasirVideo'), $('#kasirCam'), code => onKasirScan(code)));
  $('#formManual').addEventListener('submit', e => {
    e.preventDefault();
    const v = $('#inManual').value; $('#inManual').value = '';
    onKasirScan(v);
    $('#inManual').focus();
  });

  root.addEventListener('click', e => {
    const b = e.target.closest('[data-act]'); if (!b) return;
    const a = b.dataset.act, kode = b.dataset.kode;
    if (a === 'scan') { onKasirScan(b.dataset.code); return; }
    if (a === 'plus' || a === 'minus' || a === 'del') {
      const it = kasir.cart.find(c => c.kode === kode); if (!it) return;
      if (a === 'plus') it.qty++;
      if (a === 'minus') it.qty--;
      if (a === 'del' || it.qty <= 0) kasir.cart = kasir.cart.filter(c => c.kode !== kode);
    }
    if (a === 'clear') kasir.cart = [];
    if (a === 'next') {
      if (!kasir.cart.length) { toast('Belum ada barang yang dipindai', 'err'); return; }
      kasir.step = 'siswa'; kasir.siswaId = null; kasir.metode = 'Saldo'; kasir.diterima = 0;
    }
    if (a === 'back') { kasir.step = 'items'; kasir.siswaId = null; }
    if (a === 'cancelAll') { kasirReset(); toast('Semua item dibatalkan'); }
    if (a === 'cash') kasir.metode = 'Cash';
    if (a === 'ganti') kasir.siswaId = null;
    if (a === 'proses') { kasirProses(); return; }
    if (a === 'baru') kasirReset();
    renderKasirStep(); renderKasirPanel();
  });

  root.addEventListener('change', e => {
    if (e.target.id === 'selMetode') { kasir.metode = e.target.value; kasir.diterima = 0; renderKasirPanel(); }
  });
  root.addEventListener('input', e => {
    if (e.target.id !== 'inDiterima') return;
    kasir.diterima = Number(e.target.value) || 0;
    const total = kasirTotal(), ev = evalKasir();
    const k = $('#kembalian'), btn = $('#btnProses');
    if (k) k.textContent = kasir.diterima >= total ? fmtRp(kasir.diterima - total) : 'Uang kurang ' + fmtRp(total - kasir.diterima);
    if (btn) btn.disabled = !(ev.ok && kasir.diterima >= total);
  });
}

function onKasirScan(raw) {
  raw = String(raw || '').trim(); if (!raw) return;
  const kind = kindOf(raw);
  if (kasir.step === 'items') {
    if (kind === 'siswa') { toast('Itu QR siswa. Selesaikan scan barang dulu, lalu klik “Lanjut”.', 'err'); return; }
    const p = parseBarang(raw);
    if (!p) { toast('QR barang tidak dikenali: ' + raw, 'err'); return; }
    const it = kasir.cart.find(c => c.kode === p.kode);
    if (it) it.qty++; else kasir.cart.push({ kode: p.kode, nama: p.nama, harga: p.harga, qty: 1 });
    renderKasirPanel();
    toast(p.nama + ' ditambahkan');
  } else if (kasir.step === 'siswa') {
    if (kind === 'barang') { toast('Itu QR barang. Sekarang scan QR siswa.', 'err'); return; }
    const s = parseSiswa(raw);
    if (!s) { toast('QR siswa tidak dikenali: ' + raw, 'err'); return; }
    kasir.siswaId = s.id; kasir.metode = 'Saldo'; kasir.diterima = 0;
    renderKasirPanel();
    const ev = evalKasir();
    if (ev.ok) toast('Siswa: ' + s.nama + ' — transaksi valid');
    else toast('Ditolak: ' + ev.msg, 'err');
  } else {
    toast('Transaksi sudah selesai. Klik “Transaksi Baru”.', 'err');
  }
}

function kasirProses() {
  const ev = evalKasir();
  const total = kasirTotal();
  if (!ev.ok) { toast(ev.msg, 'err'); return; }
  if (kasir.metode === 'Cash' && kasir.diterima < total) { toast('Uang diterima kurang', 'err'); return; }
  const s = getSiswa(kasir.siswaId);
  const items = kasir.cart.map(c => ({ kode: c.kode, nama: c.nama, qty: c.qty, harga: c.harga }));
  const rec = {
    id: uid(), siswaId: s.id, tanggal: today(), waktu: nowHMS(),
    keterangan: items.map(i => `${i.qty}× ${i.nama}`).join(', '),
    nominal: -total, metode: kasir.metode, items, petugas: currentUser.nama,
  };
  DB.kantin.push(rec); save();
  kasir.hasil = { rec, saldoSetelah: saldoSiswa(s.id), kembalian: kasir.metode === 'Cash' ? kasir.diterima - total : 0 };
  kasir.step = 'selesai';
  renderKasirStep(); renderKasirPanel();
  toast('Transaksi berhasil (' + kasir.metode + ')');
}

function renderKasirStep() {
  const el = $('#kasirSteps'); if (!el) return;
  const idx = { items: 0, siswa: 1, selesai: 2 }[kasir.step];
  el.innerHTML = `<div class="steps">${['1. Scan QR Barang', '2. Scan QR Siswa & Validasi', '3. Selesai'].map((t, i) =>
    `<div class="step ${i === idx ? 'active' : i < idx ? 'done' : ''}"><i>${i < idx ? '✓' : i + 1}</i>${t}</div>`).join('')}</div>`;

  const T = {
    items:   ['Scan QR Barang', 'Pindai semua barang belanjaan satu per satu', 'Kode barang (contoh: BRG-001) lalu Enter'],
    siswa:   ['Scan QR Siswa', 'Pindai kartu QR siswa pemilik transaksi', 'NIS / kode QR siswa lalu Enter'],
    selesai: ['Transaksi Selesai', 'Mulai transaksi baru untuk siswa berikutnya', ''],
  }[kasir.step];
  $('#kasirScanTitle').textContent = T[0];
  $('#kasirScanSub').textContent = T[1];
  const inp = $('#inManual'); if (inp) { inp.placeholder = T[2]; inp.disabled = kasir.step === 'selesai'; }

  let q = '';
  if (kasir.step === 'items') {
    q = `<div class="quick-lbl">Simulasi scan (demo) — ketuk barang</div><div class="chip-row">${DB.produk.map(p =>
      `<button class="chip" data-act="scan" data-code="${esc(qrBarangText(p))}">${esc(p.nama)} · ${fmtRp(p.harga)}</button>`).join('')}</div>`;
  } else if (kasir.step === 'siswa') {
    q = `<div class="quick-lbl">Simulasi scan (demo) — ketuk siswa</div><div class="chip-row">${DB.siswa.map(s =>
      `<button class="chip" data-act="scan" data-code="${esc(qrSiswaText(s))}">${esc(s.nama.split(' ').slice(0, 2).join(' '))} · ${s.kelas}</button>`).join('')}</div>`;
  }
  $('#kasirQuick').innerHTML = q;
}

function cartTable(editable) {
  if (!kasir.cart.length) return '<div class="empty"><span class="ico">🛒</span>Belum ada barang. Scan QR barang untuk menambahkan.</div>';
  return `<div class="tbl-wrap"><table>
    <thead><tr><th>Barang</th><th>Harga</th><th>Qty</th><th>Subtotal</th>${editable ? '<th></th>' : ''}</tr></thead>
    <tbody>${kasir.cart.map(c => `<tr>
      <td><b>${esc(c.nama)}</b><div style="font-size:11px;color:var(--muted)">${esc(c.kode)}</div></td>
      <td>${fmtRp(c.harga)}</td>
      <td>${editable ? `<span class="qty"><button data-act="minus" data-kode="${esc(c.kode)}">−</button><b>${c.qty}</b><button data-act="plus" data-kode="${esc(c.kode)}">+</button></span>` : c.qty}</td>
      <td><b>${fmtRp(c.harga * c.qty)}</b></td>
      ${editable ? `<td><button class="btn btn-sm btn-danger" data-act="del" data-kode="${esc(c.kode)}" title="Batalkan item">✕</button></td>` : ''}
    </tr>`).join('')}</tbody></table></div>`;
}

function renderKasirPanel() {
  const el = $('#kasirPanel'); if (!el) return;
  const total = kasirTotal();

  /* ---- Langkah 3: selesai ---- */
  if (kasir.step === 'selesai') {
    const h = kasir.hasil, r = h.rec, s = getSiswa(r.siswaId), tot = Math.abs(r.nominal);
    el.innerHTML = `<div class="stack">
      <div class="alert ok"><b>✅ Transaksi berhasil</b> — ${esc(s.nama)} (Kelas ${s.kelas})</div>
      <div class="tbl-wrap"><table><thead><tr><th>Barang</th><th>Qty</th><th>Subtotal</th></tr></thead><tbody>
        ${r.items.map(i => `<tr><td>${esc(i.nama)}</td><td>${i.qty}</td><td>${fmtRp(i.harga * i.qty)}</td></tr>`).join('')}
      </tbody></table></div>
      <div class="list-item"><span>Total belanja</span><b>${fmtRp(tot)}</b></div>
      <div class="list-item"><span>Metode pembayaran</span>${metodeBadge(r.metode)}</div>
      ${r.metode === 'Cash'
        ? `<div class="list-item"><span>Uang diterima / kembalian</span><b>${fmtRp(r.items.length ? kasir.diterima : 0)} / ${fmtRp(h.kembalian)}</b></div>`
        : `<div class="list-item"><span>Saldo setelah transaksi</span><b>${fmtRp(h.saldoSetelah)}</b></div>`}
      <div class="list-item"><span>Terpakai hari ini / limit</span><b>${fmtRp(terpakaiHariIni(s.id))} / ${fmtRp(limitSiswa(s))}</b></div>
      <button class="btn btn-primary w100" data-act="baru">＋ Transaksi Baru</button></div>`;
    return;
  }

  /* ---- Langkah 1: input barang ---- */
  if (kasir.step === 'items') {
    el.innerHTML = `
      <div class="card-head"><div><h3>🛒 Daftar Belanja</h3><p>${kasir.cart.reduce((a, c) => a + c.qty, 0)} item • batalkan item dengan tombol ✕</p></div></div>
      ${cartTable(true)}
      <div class="list-item" style="margin-top:8px"><span style="font-weight:700">Total</span>
        <b style="font-size:20px;color:var(--primary)">${fmtRp(total)}</b></div>
      <div class="actions" style="margin-top:10px">
        <button class="btn btn-ghost" data-act="clear" ${kasir.cart.length ? '' : 'disabled'}>Kosongkan</button>
        <button class="btn btn-primary" style="flex:1" data-act="next" ${kasir.cart.length ? '' : 'disabled'}>Semua item sudah dipindai → Scan QR Siswa</button>
      </div>`;
    return;
  }

  /* ---- Langkah 2: scan siswa & validasi ---- */
  const s = getSiswa(kasir.siswaId);
  if (!s) {
    el.innerHTML = `<div class="stack">
      <div class="card-head" style="margin-bottom:0"><div><h3>🧾 Ringkasan Belanja</h3><p>Menunggu scan QR siswa…</p></div></div>
      ${cartTable(false)}
      <div class="list-item"><span style="font-weight:700">Total</span><b style="font-size:20px;color:var(--primary)">${fmtRp(total)}</b></div>
      <div class="alert info">Pindai kartu QR siswa untuk mengidentifikasi pemilik transaksi. Saldo dan limit harian akan divalidasi otomatis.</div>
      <div class="actions">
        <button class="btn btn-ghost" data-act="back">← Ubah Item</button>
        <button class="btn btn-danger" data-act="cancelAll">Batalkan Semua Item</button>
      </div></div>`;
    return;
  }

  const ev = evalKasir();
  const cashMode = kasir.metode === 'Cash';
  const bisaProses = ev.ok && (!cashMode || kasir.diterima >= total);
  el.innerHTML = `<div class="stack">
    <div class="card-head" style="margin-bottom:0"><div>
      <h3>👤 ${esc(s.nama)}</h3><p>Kelas ${s.kelas} • NIS ${s.nis}</p></div>
      <button class="btn btn-ghost btn-sm" data-act="ganti">Ganti Siswa</button></div>
    <div class="mini">
      <div><small>Saldo Kantin</small><b>${fmtRp(ev.saldo)}</b></div>
      <div><small>Terpakai Hari Ini</small><b>${fmtRp(ev.used)} / ${fmtRp(ev.limit)}</b></div>
      <div><small>Sisa Limit</small><b>${fmtRp(ev.sisaLimit)}</b></div>
    </div>
    ${cartTable(false)}
    <div class="list-item"><span style="font-weight:700">Total Belanja</span><b style="font-size:20px;color:var(--primary)">${fmtRp(total)}</b></div>
    <div class="row-form">
      <div class="field"><label>Metode Pembayaran</label>
        <select id="selMetode">
          <option value="Saldo" ${!cashMode ? 'selected' : ''}>Saldo kantin</option>
          <option value="Cash" ${cashMode ? 'selected' : ''}>Tunai (cash)</option>
        </select></div>
      ${cashMode ? `<div class="field"><label>Uang Diterima (Rp)</label>
        <input id="inDiterima" type="number" min="0" step="500" value="${kasir.diterima || ''}" placeholder="${total}"></div>` : ''}
    </div>
    ${cashMode ? `<div class="list-item"><span>Kembalian</span><b id="kembalian">${kasir.diterima >= total ? fmtRp(kasir.diterima - total) : 'Masukkan uang diterima'}</b></div>` : ''}
    ${ev.ok
      ? `<div class="alert ok"><b>✅ Transaksi valid.</b> ${cashMode
          ? 'Pembayaran cash tetap dihitung dalam limit harian.'
          : 'Sisa saldo setelah belanja: <b>' + fmtRp(ev.saldo - total) + '</b>.'}</div>`
      : `<div class="alert err"><b>⛔ Transaksi DITOLAK.</b> ${esc(ev.msg)}<br>Batalkan item atau ubah daftar belanja.</div>`}
    <div class="actions">
      <button class="btn btn-primary" id="btnProses" data-act="proses" style="flex:1" ${bisaProses ? '' : 'disabled'}>
        ${cashMode ? '💵 Proses Pembayaran Cash' : '💳 Proses dengan Saldo'}</button>
      ${!ev.ok && ev.kode === 'saldo' ? '<button class="btn btn-gold" data-act="cash">💵 Bayar Cash</button>' : ''}
      <button class="btn btn-ghost" data-act="back">← Ubah / Batalkan Item</button>
      <button class="btn btn-danger" data-act="cancelAll">Batalkan Semua</button>
    </div></div>`;
}

/* =========================================================
   8. DASHBOARD GURU — SCAN QR ABSENSI PER JAM PELAJARAN
   Data: tanggal, jam pelajaran, mapel, guru, waktu scan, siswa
   ========================================================= */
const guruScan = () => getGuru(currentUser.ref) || DB.guru[0];

function viewScanAbsen() {
  const st = state.scan;
  return `
  <div class="card" style="margin-bottom:16px">
    <div class="row-form">
      <div class="field"><label>Tanggal</label><input type="date" value="${today()}" disabled></div>
      <div class="field"><label>Kelas</label>
        <select id="scKelas">${kelasList().map(k => `<option ${k === st.kelas ? 'selected' : ''}>${k}</option>`).join('')}</select></div>
      <div class="field"><label>Jam Pelajaran</label>
        <select id="scJam">${JAM.map(j => `<option value="${j.n}" ${j.n === st.jam ? 'selected' : ''}>Jam ke-${j.n} (${j.t})</option>`).join('')}</select></div>
      <div class="field"><label>Mata Pelajaran</label>
        <select id="scMapel">${MAPEL.map(m => `<option ${m === st.mapel ? 'selected' : ''}>${esc(m)}</option>`).join('')}</select></div>
      <div class="field"><label>Guru</label><input value="${esc(guruScan().nama)}" disabled></div>
    </div>
  </div>

  <div class="two-col">
    <div class="card">
      <div class="card-head"><div><h3>Scan QR Siswa</h3><p>Setiap siswa dipindai sekali per jam pelajaran</p></div></div>
      <div class="cam-box" id="scCam">
        <video id="scVideo" playsinline muted></video>
        <div class="cam-ph">📷 Kamera nonaktif<br>Klik “Aktifkan Kamera”, gunakan scanner barcode, atau ketik NIS di bawah</div>
      </div>
      <button class="btn btn-ghost w100" id="scBtnCam" style="margin-top:10px">📷 Aktifkan Kamera</button>
      <form class="manual-form" id="scForm" style="margin-top:10px">
        <input id="scInput" autocomplete="off" placeholder="NIS / kode QR siswa lalu Enter">
        <button class="btn btn-primary" type="submit">OK</button>
      </form>
      <div id="scFeedback" style="margin-top:12px"></div>
    </div>
    <div class="card" id="scList"></div>
  </div>`;
}

function bindScanAbsen() {
  $('#scKelas').addEventListener('change', e => { state.scan.kelas = e.target.value; setScFeedback(); renderScList(); });
  $('#scJam').addEventListener('change', e => { state.scan.jam = Number(e.target.value); setScFeedback(); renderScList(); });
  $('#scMapel').addEventListener('change', e => { state.scan.mapel = e.target.value; renderScList(); });
  $('#scBtnCam').addEventListener('click', e => camToggle(e.currentTarget, $('#scVideo'), $('#scCam'), c => onAbsenScan(c)));
  $('#scForm').addEventListener('submit', e => {
    e.preventDefault();
    const v = $('#scInput').value; $('#scInput').value = '';
    onAbsenScan(v); $('#scInput').focus();
  });
  $('#scList').addEventListener('click', e => {
    const b = e.target.closest('[data-demo]'); if (b) onAbsenScan(b.dataset.demo);
  });
  renderScList();
}

function setScFeedback(type, html) {
  const el = $('#scFeedback'); if (!el) return;
  el.innerHTML = type ? `<div class="alert ${type}">${html}</div>` : '';
}

function onAbsenScan(raw) {
  raw = String(raw || '').trim(); if (!raw) return;
  if (kindOf(raw) === 'barang') { setScFeedback('err', 'Itu QR barang kantin, bukan QR siswa.'); return; }
  const s = parseSiswa(raw);
  if (!s) { setScFeedback('err', 'QR tidak dikenali: ' + esc(raw)); return; }
  const st = state.scan, t = today();
  if (s.kelas !== st.kelas) {
    setScFeedback('err', `<b>${esc(s.nama)}</b> terdaftar di kelas ${s.kelas}, bukan kelas ${st.kelas}.`); return;
  }
  const dup = DB.absensiMapel.find(a => a.tanggal === t && a.jam === st.jam && a.siswaId === s.id);
  if (dup) {
    setScFeedback('err', `⛔ Absensi ganda ditolak: <b>${esc(s.nama)}</b> sudah tercatat pada jam ke-${st.jam} (${esc(dup.mapel)}) pukul ${dup.waktuScan}.`);
    return;
  }
  const waktuScan = nowHMS();
  DB.absensiMapel.push({
    id: uid(), tanggal: t, jam: st.jam, mapel: st.mapel, guruId: guruScan().id,
    kelas: st.kelas, siswaId: s.id, waktuScan,
  });
  save();
  setScFeedback('ok', `✅ <b>${esc(s.nama)}</b> hadir — jam ke-${st.jam}, ${esc(st.mapel)}, pukul ${waktuScan}.`);
  renderScList();
}

function renderScList() {
  const el = $('#scList'); if (!el) return;
  const st = state.scan, t = today();
  const murid = DB.siswa.filter(s => s.kelas === st.kelas);
  const recs = DB.absensiMapel.filter(a => a.tanggal === t && a.jam === st.jam && a.kelas === st.kelas);
  const hadir = murid.filter(s => recs.some(r => r.siswaId === s.id)).length;
  el.innerHTML = `
    <div class="card-head"><div><h3>Kehadiran Jam ke-${st.jam} — Kelas ${st.kelas}</h3>
      <p>${esc(st.mapel)} • ${hadir} dari ${murid.length} siswa sudah dipindai</p></div>
      <div style="min-width:130px"><div class="progress"><i style="width:${murid.length ? Math.round(hadir / murid.length * 100) : 0}%"></i></div></div></div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Siswa</th><th>Status</th><th>Waktu Scan</th><th class="no-print"></th></tr></thead>
      <tbody>${murid.map(s => {
        const r = recs.find(x => x.siswaId === s.id);
        return `<tr><td><b>${esc(s.nama)}</b><div style="font-size:11.5px;color:var(--muted)">${s.nis}</div></td>
          <td>${r ? '<span class="badge b-hadir">Hadir</span>' : '<span class="badge b-late">Belum scan</span>'}
            ${r && r.mapel !== st.mapel ? `<div style="font-size:11px;color:var(--muted);margin-top:3px">${esc(r.mapel)}</div>` : ''}</td>
          <td>${r ? r.waktuScan : '-'}</td>
          <td>${r ? '' : `<button class="btn btn-sm btn-ghost" data-demo="${esc(qrSiswaText(s))}">Demo scan</button>`}</td></tr>`;
      }).join('') || '<tr><td colspan="4"><div class="empty">Tidak ada siswa di kelas ini</div></td></tr>'}</tbody>
    </table></div>`;
}

/* =========================================================
   9. REKAP KEHADIRAN (per siswa & per mata pelajaran)
   ========================================================= */
function viewRekap() {
  const wali = currentUser.role === 'wali';
  const child = wali ? getSiswa(currentUser.ref) : null;
  const R = state.rekap;
  if (wali) R.kelas = child.kelas;

  const murid = wali ? [child] : DB.siswa.filter(s => s.kelas === R.kelas);
  const kelasSize = DB.siswa.filter(s => s.kelas === R.kelas).length;
  const all = DB.absensiMapel.filter(r => r.kelas === R.kelas && r.tanggal >= R.dari && r.tanggal <= R.sampai
    && (R.mapel === 'Semua' || r.mapel === R.mapel));
  const data = wali ? all.filter(r => r.siswaId === child.id) : all;

  // Jumlah sesi = kombinasi unik tanggal + jam per mapel (untuk kelas tsb)
  const sesi = {};
  all.forEach(r => { (sesi[r.mapel] ||= new Set()).add(r.tanggal + '|' + r.jam); });
  const mapels = Object.keys(sesi).sort();
  const totalSesi = mapels.reduce((a, m) => a + sesi[m].size, 0);

  const rowsSiswa = murid.map(s => {
    const mine = data.filter(r => r.siswaId === s.id);
    const cells = mapels.map(m => {
      const c = mine.filter(r => r.mapel === m).length;
      return `<td>${c}<span style="color:var(--muted)">/${sesi[m].size}</span></td>`;
    }).join('');
    const pct = totalSesi ? Math.round(mine.length / totalSesi * 100) : 0;
    return `<tr><td><b>${esc(s.nama)}</b><div style="font-size:11.5px;color:var(--muted)">${s.nis}</div></td>${cells}
      <td><b>${mine.length}/${totalSesi}</b></td>
      <td><div style="display:flex;align-items:center;gap:8px"><div class="progress"><i style="width:${pct}%"></i></div><b style="font-size:12px">${pct}%</b></div></td></tr>`;
  }).join('');

  const rowsMapel = mapels.map(m => {
    const hadir = data.filter(r => r.mapel === m).length;
    const n = sesi[m].size;
    const denom = n * (wali ? 1 : kelasSize);
    const pct = denom ? Math.round(hadir / denom * 100) : 0;
    return `<tr><td><b>${esc(m)}</b></td><td>${n}</td><td>${hadir}</td>
      <td>${wali ? (hadir + ' dari ' + n + ' sesi') : (n ? (hadir / n).toFixed(1) : 0) + ' siswa/sesi'}</td>
      <td><div style="display:flex;align-items:center;gap:8px"><div class="progress"><i style="width:${pct}%"></i></div><b style="font-size:12px">${pct}%</b></div></td></tr>`;
  }).join('');

  const detail = [...data].sort((a, b) => (b.tanggal + String(b.jam).padStart(2, '0') + b.waktuScan)
    .localeCompare(a.tanggal + String(a.jam).padStart(2, '0') + a.waktuScan)).slice(0, 50);

  return `
  <div class="card" style="margin-bottom:16px">
    <div class="row-form">
      ${wali ? '' : `<div class="field"><label>Kelas</label>
        <select id="rkKelas">${kelasList().map(k => `<option ${k === R.kelas ? 'selected' : ''}>${k}</option>`).join('')}</select></div>`}
      <div class="field"><label>Mata Pelajaran</label>
        <select id="rkMapel">${['Semua', ...MAPEL].map(m => `<option ${m === R.mapel ? 'selected' : ''}>${esc(m)}</option>`).join('')}</select></div>
      <div class="field"><label>Dari Tanggal</label><input type="date" id="rkDari" value="${R.dari}"></div>
      <div class="field"><label>Sampai Tanggal</label><input type="date" id="rkSampai" value="${R.sampai}"></div>
      <div class="field"><label>&nbsp;</label><button class="btn btn-primary" id="rkTampil">🔄 Tampilkan</button></div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><div><h3>Rekap per Siswa</h3>
      <p>Kelas ${R.kelas} • ${fmtTgl(R.dari)} s.d. ${fmtTgl(R.sampai)} • format: hadir/jumlah sesi</p></div></div>
    ${mapels.length ? `<div class="tbl-wrap"><table>
      <thead><tr><th>Siswa</th>${mapels.map(m => `<th>${esc(m)}</th>`).join('')}<th>Total</th><th>% Hadir</th></tr></thead>
      <tbody>${rowsSiswa}</tbody></table></div>`
      : '<div class="empty"><span class="ico">📊</span>Belum ada data scan pada filter ini</div>'}
  </div>

  <div class="card">
    <div class="card-head"><div><h3>Rekap per Mata Pelajaran</h3><p>Ringkasan sesi dan tingkat kehadiran</p></div></div>
    ${mapels.length ? `<div class="tbl-wrap"><table>
      <thead><tr><th>Mata Pelajaran</th><th>Jumlah Sesi</th><th>Total Kehadiran</th><th>Rata-rata</th><th>% Kehadiran</th></tr></thead>
      <tbody>${rowsMapel}</tbody></table></div>`
      : '<div class="empty"><span class="ico">📚</span>Belum ada data</div>'}
  </div>

  <div class="card">
    <div class="card-head"><div><h3>Log Scan Absensi</h3><p>${data.length} catatan (menampilkan 50 terbaru)</p></div></div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Tanggal</th><th>Jam Ke</th><th>Mata Pelajaran</th><th>Guru</th><th>Waktu Scan</th><th>Siswa</th></tr></thead>
      <tbody>${detail.map(r => `<tr>
        <td>${fmtTgl(r.tanggal)}</td><td>${r.jam}</td><td>${esc(r.mapel)}</td>
        <td>${esc(getGuru(r.guruId)?.nama || '-')}</td><td>${r.waktuScan}</td>
        <td><b>${esc(getSiswa(r.siswaId)?.nama || '-')}</b></td></tr>`).join('')
        || '<tr><td colspan="6"><div class="empty">Belum ada data</div></td></tr>'}</tbody></table></div>
  </div>`;
}

function bindRekap() {
  $('#rkTampil').addEventListener('click', () => {
    const k = $('#rkKelas'); if (k) state.rekap.kelas = k.value;
    state.rekap.mapel = $('#rkMapel').value;
    state.rekap.dari = $('#rkDari').value || dayStr(-30);
    state.rekap.sampai = $('#rkSampai').value || today();
    renderView();
  });
}

/* =========================================================
   10. CETAK QR CODE SISWA — A4, TEPAT 8 KARTU PER HALAMAN
   ========================================================= */
function qrCardHTML(s) {
  return `<div class="qr-card">
    <div class="qc-head"><div class="lg">🕌</div>
      <div><b>SD Program Unggulan Assunniyyah</b><span>Kartu QR Siswa • Pasirian, Lumajang</span></div></div>
    <div class="qc-body">
      <div class="qc-qr">${qrSvg(qrSiswaText(s))}</div>
      <div class="qc-info">
        <div class="nm">${esc(s.nama)}</div>
        <div class="rw"><small>NIS</small>${esc(s.nis)}</div>
        <div class="rw"><small>Kelas</small>${esc(s.kelas)}</div>
      </div>
    </div>
    <div class="qc-foot">Tunjukkan kartu ini saat absensi kelas & transaksi kantin</div>
  </div>`;
}

function viewQrCetak() {
  const kelas = state.qrKelas;
  const list = DB.siswa.filter(s => kelas === 'Semua' || s.kelas === kelas);
  const pages = [];
  for (let i = 0; i < list.length; i += 8) pages.push(list.slice(i, i + 8));

  return `
    <div class="card no-print" style="margin-bottom:16px">
      <div class="row-form">
        <div class="field"><label>Cetak untuk</label>
          <select id="qrKelas">${['Semua', ...kelasList()].map(k => `<option ${k === kelas ? 'selected' : ''}>${k}</option>`).join('')}</select></div>
        <div class="field"><label>&nbsp;</label>
          <button class="btn btn-primary" id="btnCetak" ${list.length ? '' : 'disabled'}>🖨️ Cetak / Simpan PDF</button></div>
      </div>
      <p style="font-size:12px;color:var(--muted);margin-top:12px;line-height:1.6">
        ${list.length} siswa • ${pages.length} halaman A4 • 8 kartu per halaman (2 kolom × 4 baris, masing-masing 95 × 69 mm).
        Pada dialog cetak pilih kertas <b>A4</b>, skala <b>100%</b> (jangan “Fit to page”), lalu potong mengikuti garis putus-putus.
      </p>
    </div>
    <div class="qr-pages">
      ${pages.map(p => `<div class="qr-page">${p.map(qrCardHTML).join('')}${'<div class="qr-card blank"></div>'.repeat(8 - p.length)}</div>`).join('')
        || '<div class="empty"><span class="ico">🔳</span>Tidak ada siswa</div>'}
    </div>`;
}

function bindQrCetak() {
  $('#qrKelas').addEventListener('change', e => { state.qrKelas = e.target.value; renderView(); });
  const b = $('#btnCetak'); if (b) b.addEventListener('click', () => window.print());
}

/* =========================================================
   11. QR BARANG KANTIN (label untuk dipindai kasir)
   ========================================================= */
function viewQrBarang() {
  return `
    <div class="card no-print" style="margin-bottom:16px">
      <div class="card-head" style="margin-bottom:0"><div>
        <h3>Label QR Barang</h3>
        <p>${DB.produk.length} barang • cetak lalu tempel pada kemasan/rak. Kasir memindai label ini pada langkah pertama.</p></div>
        <button class="btn btn-primary" id="btnCetakBarang">🖨️ Cetak Label</button></div>
    </div>
    <div class="lbl-grid">
      ${DB.produk.map(p => `<div class="lbl"><div class="q">${qrSvg(qrBarangText(p))}</div>
        <b>${esc(p.nama)}</b><span>${fmtRp(p.harga)}</span><code>${esc(p.kode)}</code></div>`).join('')}
    </div>`;
}
function bindQrBarang() { $('#btnCetakBarang').addEventListener('click', () => window.print()); }

/* =========================================================
   START
   ========================================================= */
render();
</script>
</body>
</html>
