<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SD Program Unggulan Assunniyyah — Sistem Informasi Sekolah</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --primary:#0b6b3a; --primary-2:#128a4c; --primary-soft:#e6f4ec;
    --gold:#d9a419; --bg:#f2f6f3; --card:#ffffff; --text:#14251c;
    --muted:#6b7f74; --border:#e1e9e4; --radius:14px;
    --danger:#c0392b; --warn:#e08e0b;
  }
  body{font-family:'Segoe UI',system-ui,-apple-system,"Helvetica Neue",sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
  button{font-family:inherit;cursor:pointer}
  button:disabled{opacity:.5;cursor:not-allowed;transform:none!important}
  input,select,textarea{font-family:inherit;font-size:14px}

  /* ============ LOGIN ============ */
  .login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;
    background:radial-gradient(circle at 15% 20%,#128a4c33,transparent 45%),
               radial-gradient(circle at 85% 80%,#d9a41933,transparent 45%),
               linear-gradient(140deg,#0b6b3a,#0a5230 60%,#073d24)}
  .login-card{width:100%;max-width:420px;background:#fff;border-radius:20px;padding:34px 30px;
    box-shadow:0 24px 60px rgba(0,0,0,.32);text-align:center}
  .login-logo{width:70px;height:70px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;
    font-size:34px;background:linear-gradient(145deg,var(--primary),var(--primary-2));color:#fff;
    box-shadow:0 8px 20px #0b6b3a55}
  .login-card h1{font-size:18px;line-height:1.35;color:var(--primary);margin-bottom:6px}
  .login-sub{font-size:12px;color:var(--muted);margin-bottom:22px;line-height:1.5}
  .login-card label{display:block;text-align:left;font-size:12px;font-weight:600;color:var(--muted);
    margin:12px 0 6px;text-transform:uppercase;letter-spacing:.4px}
  .login-card input{width:100%;padding:11px 13px;border:1.5px solid var(--border);border-radius:10px;
    outline:none;transition:.2s;background:#fbfdfc}
  .login-card input:focus{border-color:var(--primary-2);box-shadow:0 0 0 3px #128a4c22}
  .demo-box{margin-top:20px;background:var(--primary-soft);border-radius:12px;padding:12px 14px;text-align:left}
  .demo-box strong{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--primary)}
  .demo-row{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;color:#33513f}
  .demo-row code{background:#fff;padding:1px 7px;border-radius:5px;font-size:11.5px;color:var(--primary);font-weight:600}

  /* ============ APP SHELL ============ */
  .layout{display:flex;min-height:100vh}
  .sidebar{width:250px;flex-shrink:0;background:linear-gradient(180deg,#0b6b3a,#084d2a);
    color:#fff;display:flex;flex-direction:column;padding:18px 14px;position:sticky;top:0;height:100vh}
  .brand{display:flex;gap:11px;align-items:center;padding:6px 6px 18px;border-bottom:1px solid #ffffff22;margin-bottom:14px}
  .brand-logo{width:42px;height:42px;border-radius:11px;background:#ffffff1a;display:grid;place-items:center;font-size:21px;flex-shrink:0}
  .brand-txt b{display:block;font-size:13px;line-height:1.25}
  .brand-txt span{font-size:10.5px;opacity:.72;line-height:1.3;display:block;margin-top:2px}
  .nav{display:flex;flex-direction:column;gap:4px;flex:1;overflow-y:auto}
  .nav-item{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:10px;border:none;
    background:transparent;color:#e8f5ee;font-size:13.5px;text-align:left;transition:.18s;width:100%}
  .nav-item:hover{background:#ffffff1c}
  .nav-item.active{background:#fff;color:var(--primary);font-weight:700;box-shadow:0 4px 14px #00000022}
  .nav-item .ic{font-size:16px;width:20px;text-align:center}
  .sidebar-foot{border-top:1px solid #ffffff22;padding-top:12px;margin-top:10px;font-size:11px;opacity:.6;line-height:1.5}

  .main{flex:1;min-width:0;display:flex;flex-direction:column}
  .topbar{background:#fff;border-bottom:1px solid var(--border);padding:13px 24px;
    display:flex;align-items:center;justify-content:space-between;gap:14px;position:sticky;top:0;z-index:20}
  .topbar h2{font-size:16px;color:var(--primary)}
  .topbar .sub{font-size:11.5px;color:var(--muted);margin-top:2px}
  .userbox{display:flex;align-items:center;gap:11px}
  .avatar{width:37px;height:37px;border-radius:50%;background:var(--primary-soft);color:var(--primary);
    display:grid;place-items:center;font-weight:700;font-size:14px}
  .userbox .nm{font-size:13px;font-weight:600;line-height:1.2}
  .userbox .rl{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}

  .content{padding:22px 24px 46px;max-width:1250px;width:100%}

  /* ============ COMPONENTS ============ */
  .btn{padding:9px 16px;border-radius:9px;border:1.5px solid transparent;font-size:13.5px;font-weight:600;
    transition:.18s;display:inline-flex;align-items:center;gap:7px;justify-content:center}
  .btn-primary{background:var(--primary);color:#fff}
  .btn-primary:hover{background:var(--primary-2);transform:translateY(-1px)}
  .btn-ghost{background:#fff;border-color:var(--border);color:var(--text)}
  .btn-ghost:hover{border-color:var(--primary-2);color:var(--primary)}
  .btn-sm{padding:6px 11px;font-size:12px;border-radius:7px}
  .btn-gold{background:var(--gold);color:#3a2b00}
  .btn-danger{background:#fdeceb;color:var(--danger);border-color:#f7cfcb}
  .btn-logout{background:#ffffff18;color:#fff;border:1px solid #ffffff33;padding:7px 12px;font-size:12px;border-radius:8px}
  .w100{width:100%}

  .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;
    box-shadow:0 1px 3px #0b6b3a08}
  .card + .card{margin-top:16px}
  .card-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap}
  .card-head h3{font-size:15px;color:var(--primary)}
  .card-head p{font-size:12px;color:var(--muted);margin-top:3px}

  .grid{display:grid;gap:14px}
  .g4{grid-template-columns:repeat(4,1fr)}
  .g3{grid-template-columns:repeat(3,1fr)}
  .g2{grid-template-columns:repeat(2,1fr)}

  .stat{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px 17px;
    position:relative;overflow:hidden}
  .stat::after{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--primary)}
  .stat.gold::after{background:var(--gold)}
  .stat.warn::after{background:var(--warn)}
  .stat.red::after{background:var(--danger)}
  .stat .lbl{font-size:11.5px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px}
  .stat .val{font-size:24px;font-weight:800;margin-top:6px;color:var(--primary);letter-spacing:-.5px}
  .stat.gold .val{color:#a97b00}.stat.warn .val{color:var(--warn)}.stat.red .val{color:var(--danger)}
  .stat .hint{font-size:11px;color:var(--muted);margin-top:4px}

  .field{display:flex;flex-direction:column;gap:5px}
  .field label{font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
  .field input,.field select,.field textarea{padding:9px 11px;border:1.5px solid var(--border);border-radius:9px;
    background:#fbfdfc;outline:none;transition:.18s;width:100%}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--primary-2);box-shadow:0 0 0 3px #128a4c1f}
  .field input:disabled{background:#f1f5f2;color:var(--muted)}
  .row-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;align-items:end}

  table{width:100%;border-collapse:collapse;font-size:13.5px}
  .tbl-wrap{overflow-x:auto;border-radius:11px;border:1px solid var(--border)}
  th{background:#f5f9f6;color:#3d5a49;font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;
    padding:11px 13px;text-align:left;font-weight:700;white-space:nowrap;border-bottom:1px solid var(--border)}
  td{padding:10px 13px;border-bottom:1px solid #eef3ef;vertical-align:middle}
  tr:last-child td{border-bottom:none}
  tbody tr:hover{background:#fafcfb}
  td select{padding:5px 8px;border-radius:7px;border:1.5px solid var(--border);background:#fff;font-size:12.5px;font-weight:600}

  .badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11.5px;font-weight:700;white-space:nowrap}
  .b-hadir{background:#e4f6ec;color:#127a44}
  .b-sakit{background:#fdf1dd;color:#a56a00}
  .b-izin{background:#e6eefc;color:#2559b0}
  .b-alpa{background:#fdecea;color:#b3312a}
  .b-late{background:#fdf1dd;color:#a56a00}
  .b-lunas{background:#e4f6ec;color:#127a44}
  .b-belum{background:#fdecea;color:#b3312a}
  .b-saldo{background:#e6eefc;color:#2559b0}
  .b-cash{background:#fdf1dd;color:#a56a00}
  .b-topup{background:#e4f6ec;color:#127a44}

  .progress{height:8px;background:#e9f0eb;border-radius:20px;overflow:hidden;min-width:90px}
  .progress > i{display:block;height:100%;border-radius:20px;background:linear-gradient(90deg,var(--primary),#2fb473)}

  .empty{text-align:center;padding:34px 16px;color:var(--muted);font-size:13.5px}
  .empty .ico{font-size:32px;display:block;margin-bottom:8px;opacity:.55}

  .toast{position:fixed;bottom:24px;right:24px;background:var(--primary);color:#fff;padding:12px 20px;
    border-radius:11px;font-size:13.5px;font-weight:600;box-shadow:0 10px 30px #0b6b3a55;z-index:999;
    animation:slideIn .3s ease;display:flex;gap:9px;align-items:center;max-width:min(92vw,440px)}
  .toast.err{background:var(--danger);box-shadow:0 10px 30px #c0392b55}
  @keyframes slideIn{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

  .info-strip{background:linear-gradient(120deg,var(--primary),var(--primary-2));color:#fff;
    border-radius:var(--radius);padding:18px 22px;display:flex;justify-content:space-between;
    align-items:center;gap:16px;flex-wrap:wrap;box-shadow:0 8px 24px #0b6b3a2e}
  .info-strip h3{font-size:16px;margin-bottom:3px}
  .info-strip p{font-size:12.5px;opacity:.85}
  .info-strip .big{font-size:22px;font-weight:800;background:#ffffff24;padding:8px 18px;border-radius:11px}

  .list-item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 0;
    border-bottom:1px solid #eef3ef;font-size:13.5px}
  .list-item:last-child{border-bottom:none}
  .list-item .t{font-weight:600}
  .list-item .s{font-size:11.5px;color:var(--muted);margin-top:2px}

  /* ============ SCAN / KASIR ============ */
  .two-col{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:16px;align-items:start}
  .steps{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
  .step{flex:1;min-width:130px;padding:9px 12px;border-radius:10px;background:#fff;border:1.5px solid var(--border);
    font-size:12px;font-weight:700;color:var(--muted);display:flex;gap:8px;align-items:center}
  .step i{font-style:normal;width:22px;height:22px;border-radius:50%;background:#e9f0eb;display:grid;place-items:center;font-size:11px;flex-shrink:0}
  .step.active{border-color:var(--primary-2);color:var(--primary);background:var(--primary-soft)}
  .step.active i{background:var(--primary);color:#fff}
  .step.done i{background:var(--primary-2);color:#fff}
  .cam-box{position:relative;aspect-ratio:4/3;background:#0b2b1a;border-radius:12px;overflow:hidden;display:grid;
    place-items:center;color:#9fc4af;font-size:12.5px;text-align:center;padding:12px;line-height:1.5}
  .cam-box video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
  .cam-box.on video{display:block}
  .cam-box.on .cam-ph{display:none}
  .cam-box::after{content:'';position:absolute;inset:18%;border:2px solid #ffffffbb;border-radius:14px;pointer-events:none;opacity:0}
  .cam-box.on::after{opacity:1}
  .alert{padding:11px 14px;border-radius:10px;font-size:13px;line-height:1.55}
  .alert.ok{background:#e4f6ec;color:#0f6a3b;border:1px solid #bfe6cf}
  .alert.err{background:#fdecea;color:#a3281f;border:1px solid #f5c6c1}
  .alert.info{background:#e6eefc;color:#234f9e;border:1px solid #c5d6f6}
  .chip-row{display:flex;flex-wrap:wrap;gap:6px}
  .chip{padding:6px 10px;border-radius:20px;border:1.5px solid var(--border);background:#fff;font-size:12px;font-weight:600;color:var(--text)}
  .chip:hover{border-color:var(--primary-2);color:var(--primary)}
  .quick-lbl{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px}
  .mini{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .mini div{background:#f5f9f6;border-radius:10px;padding:9px 11px}
  .mini small{display:block;font-size:10.5px;color:var(--muted);text-transform:uppercase;font-weight:700;letter-spacing:.3px}
  .mini b{font-size:15px;color:var(--primary)}
  .qty{display:inline-flex;align-items:center;gap:6px}
  .qty button{width:24px;height:24px;border-radius:6px;border:1.5px solid var(--border);background:#fff;font-weight:700}
  .stack > * + *{margin-top:12px}
  .manual-form{display:flex;gap:8px}
  .manual-form input{flex:1;padding:9px 11px;border:1.5px solid var(--border);border-radius:9px;outline:none;background:#fbfdfc}
  .manual-form input:focus{border-color:var(--primary-2);box-shadow:0 0 0 3px #128a4c1f}
  .actions{display:flex;gap:8px;flex-wrap:wrap}

  /* ============ QR CETAK ============ */
  .qr-pages{overflow-x:auto;padding-bottom:6px}
  .qr-page{width:190mm;height:276mm;background:#fff;margin:0 auto 14px;display:grid;
    grid-template-columns:repeat(2,95mm);grid-template-rows:repeat(4,69mm);
    box-shadow:0 2px 12px #0b6b3a22;break-after:page;page-break-after:always;overflow:hidden}
  .qr-page:last-child{break-after:auto;page-break-after:auto}
  .qr-card{width:95mm;height:69mm;border:.3mm dashed #8a8a8a;padding:4mm;display:flex;flex-direction:column;overflow:hidden;color:#000;background:#fff}
  .qr-card.blank{border-color:transparent}
  .qc-head{display:flex;align-items:center;gap:2mm;border-bottom:.5mm solid #0b6b3a;padding-bottom:1.6mm;margin-bottom:2.5mm}
  .qc-head .lg{font-size:5.5mm;line-height:1}
  .qc-head b{font-size:3.5mm;color:#0b6b3a;line-height:1.15;display:block}
  .qc-head span{display:block;font-size:2.4mm;color:#555}
  .qc-body{display:flex;gap:4mm;align-items:center;flex:1;min-height:0}
  .qc-qr{width:38mm;height:38mm;flex-shrink:0;border:.2mm solid #ddd}
  .qc-qr svg{width:100%;height:100%;display:block}
  .qc-info{min-width:0;flex:1}
  .qc-info .nm{font-size:4.2mm;font-weight:800;line-height:1.2;word-break:break-word}
  .qc-info .rw{font-size:3.4mm;margin-top:2mm;font-weight:600}
  .qc-info .rw small{display:block;font-size:2.2mm;color:#666;text-transform:uppercase;letter-spacing:.2mm;font-weight:600}
  .qc-foot{font-size:2.2mm;color:#666;text-align:center;margin-top:1mm}
  .lbl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
  .lbl{border:1px dashed #999;border-radius:8px;padding:10px;text-align:center;background:#fff;break-inside:avoid}
  .lbl .q{width:34mm;height:34mm;margin:0 auto 6px}
  .lbl .q svg{width:100%;height:100%;display:block}
  .lbl b{font-size:13px;display:block}
  .lbl span{font-size:12px;color:#444;display:block;margin-top:2px}
  .lbl code{font-size:10.5px;color:#777}

  @media(max-width:960px){
    .g4{grid-template-columns:repeat(2,1fr)}
    .g3{grid-template-columns:1fr}
    .g2{grid-template-columns:1fr}
    .two-col{grid-template-columns:1fr}
  }
  @media(max-width:820px){
    .layout{flex-direction:column}
    .sidebar{width:100%;height:auto;position:relative;flex-direction:row;align-items:center;
      padding:10px 12px;overflow-x:auto;gap:8px}
    .brand{border:none;margin:0;padding:0 8px 0 0;flex-shrink:0}
    .brand-txt span{display:none}
    .nav{flex-direction:row;flex:1;gap:6px;overflow-x:auto;padding-bottom:2px}
    .nav-item{white-space:nowrap;padding:8px 12px;font-size:12.5px}
    .nav-item .ic{display:none}
    .sidebar-foot{display:none}
    .content{padding:16px 14px 40px}
    .topbar{padding:11px 14px}
    .userbox .nm,.userbox .rl{display:none}
    .g4{grid-template-columns:1fr 1fr}
  }
  @media(max-width:520px){
    .g4{grid-template-columns:1fr}
    .login-card{padding:26px 20px}
    .mini{grid-template-columns:1fr}
  }

  /* ============ PRINT (A4) ============ */
  @page{size:A4;margin:10mm}
  @media print{
    body{background:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .sidebar,.topbar,.no-print,.toast{display:none!important}
    .layout,.main{display:block}
    .content{padding:0;max-width:none}
    .qr-pages{overflow:visible;padding:0}
    .qr-page{margin:0;box-shadow:none}
    .lbl-grid{grid-template-columns:repeat(4,1fr)}
  }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
