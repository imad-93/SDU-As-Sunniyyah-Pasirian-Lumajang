/* Validasi belanja: limit harian (berlaku untuk saldo & cash) + saldo */
function validasiBelanja(siswaId, total, metode) {
  const s = getSiswa(siswaId);
  const used = terpakaiHariIni(siswaId), limit = limitSiswa(s), saldo = saldoSiswa(siswaId);
  const base = { used, limit, saldo, sisaLimit: Math.max(0, limit - used) };
  if (total > limit - used)
    return { ...base, ok: false, kode: 'limit',
      msg: `Limit harian terlampaui — terpakai ${fmtRp(used)} dari limit ${fmtRp(limit)} (sisa ${fmtRp(base.sisaLimit)}), belanja ${fmtRp(total)}.` };
  if (metode === 'Saldo' && saldo < total)
    return { ...base, ok: false, kode: 'saldo',
      msg: `Saldo tidak cukup — saldo ${fmtRp(saldo)}, belanja ${fmtRp(total)} (kurang ${fmtRp(total - saldo)}).` };
  return { ...base, ok: true, kode: '', msg: '' };
}

/* ---------- QR GENERATOR ---------- */
function qrSvg(text) {
  try {
    const q = qrcode(0, 'M'); q.addData(text); q.make();
    const n = q.getModuleCount(); let path = '';
    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) path += `M${c},${r}h1v1h-1z`;
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-2 -2 ${n + 4} ${n + 4}" shape-rendering="crispEdges">
      <rect x="-2" y="-2" width="${n + 4}" height="${n + 4}" fill="#fff"/><path d="${path}" fill="#000"/></svg>`;
  } catch (e) {
    return `<div style="font:11px monospace;word-break:break-all;padding:6px;color:#a3281f">Library QR belum termuat (cek internet).<br>${esc(text)}</div>`;
  }
}

/* ---------- SCANNER KAMERA ---------- */
const Scanner = {
  stream: null, raf: 0, running: false, last: '', lastT: 0, tick: 0,
  async start(video, cb) {
    this.stop();
    if (!navigator.mediaDevices?.getUserMedia)
      return { ok: false, msg: 'Kamera tidak didukung (butuh HTTPS / localhost). Gunakan input manual.' };
    const det = ('BarcodeDetector' in window) ? new BarcodeDetector({ formats: ['qr_code'] }) : null;
    if (!window.jsQR && !det) return { ok: false, msg: 'Library pemindai QR belum termuat (cek internet).' };
    try {
      this.stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } }, audio: false });
    } catch (e) { return { ok: false, msg: 'Izin kamera ditolak atau kamera tidak tersedia.' }; }
    video.srcObject = this.stream;
    try { await video.play(); } catch (e) {}
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    this.running = true;
    const loop = async t => {
      if (!this.running) return;
      if (t - this.tick > 150 && video.readyState >= 2 && video.videoWidth) {
        this.tick = t; let code = '';
        try {
          if (window.jsQR) {
            canvas.width = video.videoWidth; canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const r = jsQR(img.data, img.width, img.height, { inversionAttempts: 'dontInvert' });
            code = r ? r.data : '';
          } else {
            const r = await det.detect(video); code = r[0]?.rawValue || '';
          }
        } catch (e) {}
        if (code) {
          const now = Date.now();
          const fresh = code !== this.last || now - this.lastT > 1800;
          this.last = code; this.lastT = now;   // selama kode masih terlihat, tidak diulang
          if (fresh) cb(code);
        }
      }
      this.raf = requestAnimationFrame(loop);
    };
    this.raf = requestAnimationFrame(loop);
    return { ok: true };
  },
  stop() {
    this.running = false; cancelAnimationFrame(this.raf);
    if (this.stream) this.stream.getTracks().forEach(t => t.stop());
    this.stream = null; this.last = '';
    document.querySelectorAll('video').forEach(v => { try { v.srcObject = null; } catch (e) {} });
  }
};
async function camToggle(btn, video, box, cb) {
  if (Scanner.running) {
    Scanner.stop(); btn.textContent = '📷 Aktifkan Kamera'; box.classList.remove('on'); return;
  }
  btn.disabled = true;
  const r = await Scanner.start(video, cb);
  btn.disabled = false;
  if (!r.ok) { toast(r.msg, 'err'); return; }
  btn.textContent = '⏹ Matikan Kamera'; box.classList.add('on');
}

/* ---------- TOAST ---------- */
function toast(msg, type) {
  const el = document.createElement('div');
  el.className = 'toast' + (type === 'err' ? ' err' : '');
  el.innerHTML = '<span>' + (type === 'err' ? '✕' : '✓') + '</span><span>' + esc(msg) + '</span>';
  document.body.appendChild(el);
  setTimeout(() => { el.style.transition = '.35s'; el.style.opacity = '0'; el.style.transform = 'translateY(14px)'; }, type === 'err' ? 3200 : 2100);
  setTimeout(() => el.remove(), type === 'err' ? 3700 : 2600);
}

