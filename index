function metodeBadge(m) {
  const cls = { 'Saldo': 'b-saldo', 'Cash': 'b-cash', 'Top Up': 'b-topup' }[m] || 'b-saldo';
  return `<span class="badge ${cls}">${esc(m || '-')}</span>`;
}

function viewKantin() {
  const role = currentUser.role, isWali = role === 'wali', isAdmin = role === 'admin';
  let list = DB.kantin;
  if (isWali) list = list.filter(k => k.siswaId === currentUser.ref);
  list = [...list].sort((a, b) => ((b.tanggal + (b.waktu || '')).localeCompare(a.tanggal + (a.waktu || ''))));

  const beli = list.filter(k => k.nominal < 0);
  const beliSaldo = beli.filter(k => k.metode !== 'Cash').reduce((a, k) => a + Math.abs(k.nominal), 0);
  const beliCash  = beli.filter(k => k.metode === 'Cash').reduce((a, k) => a + Math.abs(k.nominal), 0);
  const totalTopup = list.filter(k => k.nominal > 0).reduce((a, k) => a + k.nominal, 0);
  const saldoTampil = isWali ? saldoSiswa(currentUser.ref) : totalTopup - beliSaldo;

  const formAdmin = !isAdmin ? '' : `
    <div class="grid g2" style="margin-bottom:16px">
      <div class="card">
        <div class="card-head"><div><h3>Catat Transaksi Manual</h3><p>Top up saldo atau pembelian (tunduk pada saldo & limit harian)</p></div></div>
        <form id="formKantin">
          <div class="row-form">
            <div class="field"><label>Siswa</label>
              <select name="siswaId" required>
                ${DB.siswa.map(s => `<option value="${s.id}">${esc(s.nama)} — ${s.kelas}</option>`).join('')}
              </select>
            </div>
            <div class="field"><label>Jenis Transaksi</label>
              <select name="jenis" required>
                <option value="beli">Pembelian (saldo)</option>
                <option value="cash">Pembelian (cash)</option>
                <option value="topup">Top Up Saldo</option>
              </select>
            </div>
            <div class="field"><label>Keterangan</label>
              <input name="keterangan" required placeholder="Contoh: Nasi ayam + air mineral"></div>
            <div class="field"><label>Nominal (Rp)</label>
              <input name="nominal" type="number" min="500" step="500" required placeholder="10000"></div>
            <div class="field"><label>&nbsp;</label>
              <button class="btn btn-primary" type="submit">＋ Simpan</button></div>
          </div>
        </form>
      </div>
      <div class="card">
        <div class="card-head"><div><h3>Limit Jajan Harian</h3><p>Berlaku untuk pembayaran saldo maupun cash</p></div></div>
        <form id="formLimit">
          <div class="row-form">
            <div class="field"><label>Limit per siswa per hari (Rp)</label>
              <input name="limit" type="number" min="1000" step="500" required value="${DB.settings.limitHarian}"></div>
            <div class="field"><label>&nbsp;</label>
              <button class="btn btn-primary" type="submit">💾 Simpan Limit</button></div>
          </div>
        </form>
      </div>
    </div>`;

  const infoWali = !isWali ? '' : (() => {
    const s = getSiswa(currentUser.ref);
    return `<div class="alert info" style="margin-bottom:16px">
      Limit jajan harian: <b>${fmtRp(limitSiswa(s))}</b> • Terpakai hari ini: <b>${fmtRp(terpakaiHariIni(s.id))}</b>
      (termasuk pembayaran cash)</div>`;
  })();

  return `
    ${formAdmin}${infoWali}
    <div class="grid g4" style="margin-bottom:16px">
      <div class="stat"><div class="lbl">Pembelian via Saldo</div><div class="val">${fmtRp(beliSaldo)}</div>
        <div class="hint">${beli.filter(k => k.metode !== 'Cash').length} transaksi</div></div>
      <div class="stat warn"><div class="lbl">Pembelian via Cash</div><div class="val">${fmtRp(beliCash)}</div>
        <div class="hint">${beli.filter(k => k.metode === 'Cash').length} transaksi</div></div>
      <div class="stat gold"><div class="lbl">Total Top Up</div><div class="val">${fmtRp(totalTopup)}</div>
        <div class="hint">${list.filter(k => k.nominal > 0).length} transaksi</div></div>
      <div class="stat"><div class="lbl">${isWali ? 'Saldo Anak' : 'Saldo Tersimpan'}</div>
        <div class="val">${fmtRp(saldoTampil)}</div>
        <div class="hint">Sisa saldo kantin</div></div>
    </div>

    <div class="card">
      <div class="card-head">
        <div><h3>${isWali ? 'Riwayat Jajan Putra/Putri Anda' : 'Riwayat Transaksi Kantin'}</h3>
          <p>Transparansi transaksi siswa di kantin sekolah — tercatat metode pembayaran saldo / cash</p></div>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>${isWali ? '' : '<th>Siswa</th><th>Kelas</th>'}
              <th>Tanggal</th><th>Keterangan</th><th>Metode</th><th>Nominal</th><th>Saldo Siswa Kini</th></tr>
          </thead>
          <tbody>
            ${list.map(k => {
              const s = getSiswa(k.siswaId);
              return `<tr>
                ${isWali ? '' : `<td><b>${esc(s?.nama || '-')}</b></td><td>${s?.kelas || '-'}</td>`}
                <td>${fmtTgl(k.tanggal)}${k.waktu ? `<div style="font-size:11px;color:var(--muted)">${k.waktu.slice(0, 5)}</div>` : ''}</td>
                <td>${esc(k.keterangan)}</td>
                <td>${metodeBadge(k.metode)}</td>
                <td><b style="color:${k.nominal < 0 ? 'var(--danger)' : 'var(--primary)'}">
                  ${k.nominal < 0 ? '-' : '+'}${fmtRp(Math.abs(k.nominal))}</b></td>
