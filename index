/* =========================================================
   4. ADMINISTRASI SEKOLAH
   ========================================================= */
function viewAdministrasi() {
  const isWali = currentUser.role === 'wali';
  let list = DB.pembayaran;
  if (isWali) list = list.filter(p => p.siswaId === currentUser.ref);
  list = [...list].sort((a, b) => (a.status === 'Belum Lunas' ? -1 : 1) - (b.status === 'Belum Lunas' ? -1 : 1));

  const totalTagih = list.reduce((a, p) => a + p.nominal, 0);
  const totalBayar = list.filter(p => p.status === 'Lunas').reduce((a, p) => a + p.nominal, 0);
  const totalSisa = totalTagih - totalBayar;

  return `
    <div class="grid g3" style="margin-bottom:16px">
      <div class="stat"><div class="lbl">Total Tagihan</div><div class="val">${fmtRp(totalTagih)}</div></div>
      <div class="stat gold"><div class="lbl">Sudah Dibayar</div><div class="val">${fmtRp(totalBayar)}</div></div>
      <div class="stat red"><div class="lbl">Sisa Tagihan</div><div class="val">${fmtRp(totalSisa)}</div></div>
    </div>

    <div class="card">
      <div class="card-head">
        <div><h3>${isWali ? 'Tagihan Putra/Putri Anda' : 'Daftar Tagihan Seluruh Siswa'}</h3>
          <p>Rincian administrasi sekolah yang harus dibayarkan</p></div>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              ${isWali ? '' : '<th>Siswa</th><th>Kelas</th>'}
              <th>Jenis Tagihan</th><th>Nominal</th><th>Jatuh Tempo</th><th>Status</th>
              ${isWali ? '' : '<th>Aksi</th>'}
            </tr>
          </thead>
          <tbody>
            ${list.map(p => {
              const s = getSiswa(p.siswaId);
              return `<tr>
                ${isWali ? '' : `<td><b>${esc(s?.nama || '-')}</b></td><td>${s?.kelas || '-'}</td>`}
                <td>${esc(p.jenis)}</td>
                <td><b>${fmtRp(p.nominal)}</b></td>
                <td>${fmtTgl(p.jatuhTempo)}</td>
                <td><span class="badge ${p.status === 'Lunas' ? 'b-lunas' : 'b-belum'}">${p.status}</span></td>
                ${isWali ? '' : `<td>${p.status === 'Belum Lunas'
                  ? `<button class="btn btn-sm btn-primary btn-lunas" data-id="${p.id}">✓ Tandai Lunas</button>`
                  : '<span style="font-size:12px;color:var(--muted)">Selesai</span>'}</td>`}
              </tr>`;
            }).join('') || `<tr><td colspan="7"><div class="empty"><span class="ico">💰</span>Belum ada tagihan</div></td></tr>`}
          </tbody>
        </table>
      </div>
    </div>`;
}

function bindAdministrasi() {
  $$('.btn-lunas').forEach(b => b.addEventListener('click', () => {
    const p = DB.pembayaran.find(x => x.id === b.dataset.id);
    if (!p) return;
    p.status = 'Lunas';
    p.tanggalBayar = today();
    save();
    toast('Pembayaran ditandai lunas');
    renderView();
  }));
}

