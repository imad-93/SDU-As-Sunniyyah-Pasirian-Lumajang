  const persenHadir = absenHariIni.length ? Math.round(hadir / absenHariIni.length * 100) : 0;

  const guruHadir = DB.absensiGuru.filter(a => a.tanggal === t && a.status === 'Hadir').length;
  const totalGuru = DB.guru.length;

  const tunggakan = DB.pembayaran.filter(p => p.status === 'Belum Lunas')
    .filter(p => !isWali || p.siswaId === myChild?.id)
    .reduce((a, p) => a + p.nominal, 0);

  const kantinHariIni = DB.kantin.filter(k => k.tanggal === t && k.nominal < 0)
    .filter(k => !isWali || k.siswaId === myChild?.id);

  if (isWali && myChild) {
    const absenAnak = DB.absensiSiswa.filter(a => a.siswaId === myChild.id);
    const hadirAnak = absenAnak.filter(a => a.status === 'Hadir').length;
    const pctAnak = absenAnak.length ? Math.round(hadirAnak / absenAnak.length * 100) : 0;
    const capai = DB.capaian.filter(c => c.siswaId === myChild.id);
    const rata = capai.length ? Math.round(capai.reduce((a, c) => a + c.nilai, 0) / capai.length) : 0;
    const saldo = saldoSiswa(myChild.id);
    const belum = DB.pembayaran.filter(p => p.siswaId === myChild.id && p.status === 'Belum Lunas');

    return `
      <div class="info-strip" style="margin-bottom:16px">
        <div>
          <h3>Assalamu'alaikum, ${esc(currentUser.nama)} 👋</h3>
          <p>Putra/putri Anda: <b>${esc(myChild.nama)}</b> — NIS ${myChild.nis} — Kelas ${myChild.kelas}</p>
        </div>
        <div class="big">${pctAnak}%</div>
      </div>

      <div class="grid g4" style="margin-bottom:16px">
        <div class="stat"><div class="lbl">Kehadiran Anak</div><div class="val">${pctAnak}%</div>
          <div class="hint">${hadirAnak} dari ${absenAnak.length} hari tercatat</div></div>
        <div class="stat gold"><div class="lbl">Saldo Kantin</div><div class="val">${fmtRp(saldo)}</div>
          <div class="hint">Sisa saldo jajan</div></div>
        <div class="stat ${belum.length ? 'red' : ''}"><div class="lbl">Tagihan Belum Lunas</div>
          <div class="val">${fmtRp(belum.reduce((a, p) => a + p.nominal, 0))}</div>
          <div class="hint">${belum.length} item tagihan</div></div>
        <div class="stat"><div class="lbl">Rata-rata Capaian</div><div class="val">${rata}</div>
          <div class="hint">Dari ${capai.length} mata pelajaran</div></div>
      </div>

      <div class="grid g2">
        <div class="card">
          <div class="card-head"><div><h3>Riwayat Kehadiran Terakhir</h3><p>5 catatan terakhir</p></div></div>
          ${absenAnak.slice(-5).reverse().map(a => `
            <div class="list-item">
              <div><div class="t">${fmtTgl(a.tanggal)}</div><div class="s">${esc(a.ket) || 'Kehadiran tercatat'}</div></div>
              <span class="badge ${statusClass(a.status)}">${a.status}</span>
            </div>`).join('') || '<div class="empty"><span class="ico">📭</span>Belum ada data kehadiran</div>'}
        </div>
        <div class="card">
          <div class="card-head"><div><h3>Transaksi Kantin Terakhir</h3><p>5 transaksi terakhir</p></div></div>
          ${DB.kantin.filter(k => k.siswaId === myChild.id).slice(-5).reverse().map(k => `
            <div class="list-item">
              <div><div class="t">${esc(k.keterangan)}</div><div class="s">${fmtTgl(k.tanggal)} • ${esc(k.metode || '-')}</div></div>
              <b style="color:${k.nominal < 0 ? 'var(--danger)' : 'var(--primary)'}">
                ${k.nominal < 0 ? '-' : '+'}${fmtRp(Math.abs(k.nominal))}
              </b>
            </div>`).join('') || '<div class="empty"><span class="ico">🍱</span>Belum ada transaksi</div>'}
        </div>
      </div>`;
  }

  return `
    <div class="grid g4" style="margin-bottom:16px">
      <div class="stat"><div class="lbl">Total Siswa</div><div class="val">${totalSiswa}</div>
        <div class="hint">${kelasList().length} kelas aktif</div></div>
      <div class="stat"><div class="lbl">Kehadiran Siswa Hari Ini</div><div class="val">${persenHadir}%</div>
        <div class="hint">${hadir} hadir dari ${absenHariIni.length} siswa</div></div>
      <div class="stat gold"><div class="lbl">Guru Hadir Hari Ini</div><div class="val">${guruHadir}/${totalGuru}</div>
        <div class="hint">Termasuk izin & terlambat</div></div>
      <div class="stat red"><div class="lbl">Total Tunggakan</div><div class="val">${fmtRp(tunggakan)}</div>
        <div class="hint">${DB.pembayaran.filter(p => p.status === 'Belum Lunas').length} tagihan belum lunas</div></div>
    </div>

    <div class="grid g2">
      <div class="card">
        <div class="card-head">
          <div><h3>Kehadiran per Kelas — Hari Ini</h3><p>Rekap kehadiran seluruh kelas</p></div>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>Kelas</th><th>Siswa</th><th>Hadir</th><th>Izin/Sakit</th><th>Alpa</th><th>%</th></tr></thead>
            <tbody>
              ${kelasList().map(k => {
                const anak = DB.siswa.filter(s => s.kelas === k);
                const ab = DB.absensiSiswa.filter(a => a.tanggal === t && anak.some(x => x.id === a.siswaId));
                const h = ab.filter(a => a.status === 'Hadir').length;
                const iz = ab.filter(a => a.status === 'Izin' || a.status === 'Sakit').length;
                const al = ab.filter(a => a.status === 'Alpa').length;
                const pct = ab.length ? Math.round(h / ab.length * 100) : 0;
                return `<tr>
                  <td><b>${k}</b></td><td>${anak.length}</td>
                  <td><span class="badge b-hadir">${h}</span></td>
                  <td><span class="badge b-izin">${iz}</span></td>
                  <td><span class="badge ${al ? 'b-alpa' : 'b-hadir'}">${al}</span></td>
                  <td><div style="display:flex;align-items:center;gap:8px">
                    <div class="progress"><i style="width:${pct}%"></i></div><b style="font-size:12px">${pct}%</b>
                  </div></td>
                </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><div><h3>Aktivitas Kantin Hari Ini</h3><p>${kantinHariIni.length} transaksi pembelian</p></div></div>
        ${kantinHariIni.length ? kantinHariIni.slice(-6).reverse().map(k => `
          <div class="list-item">
            <div><div class="t">${esc(getSiswa(k.siswaId)?.nama || '-')}</div>
              <div class="s">${esc(k.keterangan)} • ${esc(k.metode || '-')}</div></div>
            <b style="color:var(--danger)">${fmtRp(Math.abs(k.nominal))}</b>
          </div>`).join('') : '<div class="empty"><span class="ico">🍱</span>Belum ada transaksi hari ini</div>'}
      </div>
    </div>`;
}

function statusClass(s) {
  return { 'Hadir':'b-hadir', 'Sakit':'b-sakit', 'Izin':'b-izin', 'Alpa':'b-alpa', 'Terlambat':'b-late' }[s] || 'b-hadir';
}

/* =========================================================
   2. ABSEN SISWA (harian)
   ========================================================= */
function viewAbsenSiswa() {
  if (currentUser.role === 'wali') {
    const anak = getSiswa(currentUser.ref);
    const data = DB.absensiSiswa.filter(a => a.siswaId === anak?.id).sort((a, b) => b.tanggal.localeCompare(a.tanggal));
    const total = data.length;
    const hadir = data.filter(d => d.status === 'Hadir').length;
    const pct = total ? Math.round(hadir / total * 100) : 0;

    return `
      <div class="grid g4" style="margin-bottom:16px">
        <div class="stat"><div class="lbl">Total Hari Tercatat</div><div class="val">${total}</div></div>
        <div class="stat"><div class="lbl">Hadir</div><div class="val">${hadir}</div></div>
        <div class="stat warn"><div class="lbl">Izin / Sakit</div>
          <div class="val">${data.filter(d => d.status === 'Izin' || d.status === 'Sakit').length}</div></div>
        <div class="stat red"><div class="lbl">Tanpa Keterangan</div>
          <div class="val">${data.filter(d => d.status === 'Alpa').length}</div></div>
      </div>
      <div class="card">
        <div class="card-head">
          <div><h3>Riwayat Kehadiran — ${esc(anak?.nama || '-')}</h3>
            <p>Kelas ${anak?.kelas} • NIS ${anak?.nis}</p></div>
          <div style="font-size:16px;font-weight:800;color:var(--primary)">${pct}% Kehadiran</div>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>Tanggal</th><th>Status</th><th>Keterangan</th></tr></thead>
            <tbody>
              ${data.map(d => `<tr>
                <td>${fmtTgl(d.tanggal)}</td>
                <td><span class="badge ${statusClass(d.status)}">${d.status}</span></td>
                <td>${esc(d.ket) || '-'}</td>
              </tr>`).join('') || '<tr><td colspan="3"><div class="empty">Belum ada data kehadiran</div></td></tr>'}
            </tbody>
          </table>
        </div>
      </div>`;
  }

  const list = DB.siswa.filter(s => s.kelas === state.absenKelas);
  const tgl = state.absenTanggal;

  const rows = list.map(s => {
    const rec = DB.absensiSiswa.find(a => a.tanggal === tgl && a.siswaId === s.id);
    const st = rec?.status || 'Hadir';
    return `<tr data-sid="${s.id}">
      <td><b>${esc(s.nama)}</b><div class="s" style="font-size:11.5px;color:var(--muted)">${s.nis}</div></td>
      <td>${s.kelas}</td>
      <td>
        <select class="sel-status">
          ${['Hadir','Sakit','Izin','Alpa'].map(o => `<option ${o === st ? 'selected' : ''}>${o}</option>`).join('')}
        </select>
      </td>
      <td><input class="in-ket" value="${esc(rec?.ket || '')}" placeholder="Keterangan (opsional)"
           style="padding:6px 9px;border:1.5px solid var(--border);border-radius:7px;width:100%;max-width:260px"></td>
    </tr>`;
  }).join('');

  return `
    <div class="card" style="margin-bottom:16px">
      <div class="row-form">
        <div class="field"><label>Tanggal</label>
          <input type="date" id="inTanggal" value="${tgl}"></div>
        <div class="field"><label>Kelas</label>
          <select id="inKelas">${kelasList().map(k => `<option ${k === state.absenKelas ? 'selected' : ''}>${k}</option>`).join('')}</select></div>
        <div class="field"><label>&nbsp;</label>
          <button class="btn btn-ghost" id="btnTampil">🔄 Tampilkan</button></div>
        <div class="field"><label>&nbsp;</label>
          <button class="btn btn-primary" id="btnSimpanAbsen">💾 Simpan Absensi</button></div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <div><h3>Daftar Kehadiran Siswa</h3>
          <p>Kelas ${state.absenKelas} • ${fmtTgl(tgl)} • ${list.length} siswa</p></div>
      </div>
      <div class="tbl-wrap">
        <table id="tblAbsenSiswa">
          <thead><tr><th>Nama Siswa</th><th>Kelas</th><th>Status</th><th>Keterangan</th></tr></thead>
          <tbody>${rows || '<tr><td colspan="4"><div class="empty">Tidak ada siswa di kelas ini</div></td></tr>'}</tbody>
        </table>
      </div>
    </div>`;
}

function bindAbsenSiswa() {
  if (currentUser.role === 'wali') return;
  $('#btnTampil').addEventListener('click', () => {
    state.absenTanggal = $('#inTanggal').value || today();
    state.absenKelas = $('#inKelas').value;
    renderView();
  });
  $('#btnSimpanAbsen').addEventListener('click', () => {
    const tgl = state.absenTanggal;
    $$('#tblAbsenSiswa tbody tr[data-sid]').forEach(tr => {
      const sid = tr.dataset.sid;
      const status = tr.querySelector('.sel-status').value;
      const ket = tr.querySelector('.in-ket').value.trim();
      DB.absensiSiswa = DB.absensiSiswa.filter(a => !(a.tanggal === tgl && a.siswaId === sid));
      DB.absensiSiswa.push({ id: uid(), tanggal: tgl, siswaId: sid, status, ket });
    });
    save();
    toast('Absensi siswa berhasil disimpan');
    renderView();
  });
}

