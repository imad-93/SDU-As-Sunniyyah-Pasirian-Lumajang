      </div>
    </div>`;
}

function bindKantin() {
  const form = $('#formKantin');
  if (form) form.addEventListener('submit', e => {
    e.preventDefault();
    const fd = new FormData(form);
    const nominal = Math.abs(Number(fd.get('nominal')));
    const jenis = fd.get('jenis');
    const siswaId = fd.get('siswaId');
    let metode = 'Top Up';
    if (jenis !== 'topup') {
      metode = jenis === 'cash' ? 'Cash' : 'Saldo';
      const v = validasiBelanja(siswaId, nominal, metode);
      if (!v.ok) { toast(v.msg, 'err'); return; }
    }
    DB.kantin.push({
      id: uid(), siswaId, tanggal: today(), waktu: nowHMS(),
      keterangan: fd.get('keterangan').trim(),
      nominal: jenis === 'topup' ? nominal : -nominal, metode,
    });
    save();
    toast('Transaksi kantin tersimpan');
    renderView();
  });

  const fl = $('#formLimit');
  if (fl) fl.addEventListener('submit', e => {
    e.preventDefault();
    DB.settings.limitHarian = Math.max(1000, Number(new FormData(fl).get('limit')) || 20000);
    save();
    toast('Limit harian diperbarui: ' + fmtRp(DB.settings.limitHarian));
    renderView();
  });
}

