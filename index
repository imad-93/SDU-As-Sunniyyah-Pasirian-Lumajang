<body>
<div id="app"></div>

<script>
/* =========================================================
   SD PROGRAM UNGGULAN ASSUNNIYYAH
   Jl. Tegir, Desa Pasirian, Kec. Pasirian, Kab. Lumajang
   Aplikasi Sistem Informasi Sekolah (versi demo, data lokal)
   ========================================================= */

const STORAGE_KEY = 'assunniyyah_db_v2';

/* ---------- HELPERS ---------- */
const $  = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
const pad = n => String(n).padStart(2, '0');
const fmtDateLocal = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const today = () => fmtDateLocal(new Date());           // tanggal LOKAL (bukan UTC)
const dayStr = off => { const d = new Date(); d.setDate(d.getDate() + off); return fmtDateLocal(d); };
const nowHMS = () => { const d = new Date(); return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`; };
const fmtRp = n => 'Rp ' + Number(n).toLocaleString('id-ID');
const fmtTgl = s => {
  if (!s) return '-';
  const d = new Date(s + 'T00:00:00');
  return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
};
const esc = t => String(t ?? '').replace(/[&<>"']/g, c =>
  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

/* ---------- KONSTANTA AKADEMIK ---------- */
const JAM = [
  { n: 1, s: '07:00', t: '07:00–07:35' }, { n: 2, s: '07:35', t: '07:35–08:10' },
  { n: 3, s: '08:10', t: '08:10–08:45' }, { n: 4, s: '08:45', t: '08:45–09:20' },
  { n: 5, s: '09:40', t: '09:40–10:15' }, { n: 6, s: '10:15', t: '10:15–10:50' },
  { n: 7, s: '10:50', t: '10:50–11:25' }, { n: 8, s: '11:25', t: '11:25–12:00' },
];
const MAPEL = ["Al-Qur'an (Tahfidz)", 'Pendidikan Agama Islam', 'Bahasa Indonesia', 'Matematika',
  'IPAS', 'Bahasa Arab', 'Bahasa Inggris', 'PJOK', 'Seni & Prakarya', 'Pendidikan Pancasila'];
function detectJam() {
  const d = new Date(); const m = d.getHours() * 60 + d.getMinutes(); let r = 1;
  JAM.forEach(j => { const [h, mm] = j.s.split(':').map(Number); if (m >= h * 60 + mm) r = j.n; });
  return r;
}

/* ---------- FORMAT QR ---------- */
const SISWA_PREFIX = 'ASN-S:', BARANG_PREFIX = 'ASN-B:';
const qrSiswaText = s => SISWA_PREFIX + s.nis;
const qrBarangText = p => BARANG_PREFIX + p.kode;
const kindOf = c => /^ASN-S:/i.test(c) ? 'siswa' : /^ASN-B:/i.test(c) ? 'barang' : null;

/* ---------- SEED DATA ---------- */
function seed() {
  const siswa = [
    { id:'s1',  nis:'2425001', nama:'Ahmad Fauzan',       kelas:'1A', wali:'Bapak Hasan'   },
